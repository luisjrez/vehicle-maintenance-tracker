generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The anonymous holder of all data (ADR-0001). There are no user accounts.
model Owner {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  devices  Device[]
  vehicles Vehicle[]

  @@map("owners")
}

/// An app install acting for an Owner. Only the HMAC of its Device ID is stored;
/// revoking a device deletes the row.
model Device {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  deviceIdHash String   @unique @map("device_id_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("devices")
}

/// A car belonging to an Owner. Decoded VIN details are copied in and stay
/// editable; current mileage is derived from readings, never stored (ADR-0007).
model Vehicle {
  id                  String   @id @default(uuid(7)) @db.Uuid
  ownerId             String   @map("owner_id") @db.Uuid
  vin                 String?  @db.Char(17)
  year                Int      @db.SmallInt
  make                String
  model               String
  trim                String?
  bodyClass           String?  @map("body_class")
  vehicleType         String?  @map("vehicle_type")
  fuelType            String?  @map("fuel_type")
  electrification     String?
  cylinders           Int?     @db.SmallInt
  displacementL       Decimal? @map("displacement_l") @db.Decimal(4, 1)
  driveType           String?  @map("drive_type")
  nickname            String?
  plate               String?
  plateState          String?  @map("plate_state") @db.Char(2)
  color               String?
  initialOdometer     Int      @map("initial_odometer")
  initialOdometerDate DateTime @map("initial_odometer_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  records ServiceRecord[]

  // VIN is unique per Owner only (ADR-0003); NULLs never collide in Postgres.
  @@unique([ownerId, vin])
  @@index([ownerId])
  @@map("vehicles")
}

/// Shared vPIC decode cache, keyed by VIN and never linked to an Owner (ADR-0003).
/// Decoded hits never expire; "no data" expires after ~24 h; outages are not cached.
model VinDecodeCache {
  vin       String    @id @db.Char(17)
  status    String
  details   Json
  payload   Json
  fetchedAt DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  @@map("vin_decode_cache")
}

enum ProviderType {
  dealer
  chain
  independent
  diy

  @@map("provider_type")
}

/// One visit/job on a date (ADR-0004, domain model). Hard-deleted with its vehicle.
model ServiceRecord {
  id           String        @id @default(uuid(7)) @db.Uuid
  vehicleId    String        @map("vehicle_id") @db.Uuid
  date         DateTime      @db.Date
  odometer     Int?
  providerName String?       @map("provider_name")
  providerType ProviderType? @map("provider_type")
  notes        String?
  totalCents   Int           @map("total_cents")
  currency     String        @default("USD") @db.Char(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lineItems LineItem[]

  @@index([vehicleId, date])
  @@map("service_records")
}

/// A service performed within a record: a catalog slug XOR a custom name.
model LineItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  recordId    String  @map("record_id") @db.Uuid
  position    Int     @db.SmallInt
  serviceSlug String? @map("service_slug")
  customName  String? @map("custom_name")
  costCents   Int?    @map("cost_cents")
  notes       String?
  packageCode String? @map("package_code")

  record  ServiceRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  service CatalogService? @relation(fields: [serviceSlug], references: [slug], onDelete: Restrict)

  @@index([recordId])
  @@map("line_items")
}

/// Seeded from packages/shared on every deploy; never edited by hand (ADR-0004).
model CatalogCategory {
  slug     String           @id
  name     String
  position Int              @db.SmallInt
  services CatalogService[]

  @@map("catalog_categories")
}

model CatalogService {
  slug            String  @id
  categorySlug    String  @map("category_slug")
  name            String
  description     String
  typicalInterval String? @map("typical_interval")
  retired         Boolean @default(false)

  category  CatalogCategory @relation(fields: [categorySlug], references: [slug])
  lineItems LineItem[]

  @@map("catalog_services")
}
