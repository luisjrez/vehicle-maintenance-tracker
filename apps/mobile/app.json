{
  "expo": {
    "name": "Maintenance Tracker",
    "slug": "vehicle-maintenance-tracker",
    "scheme": "vmt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.luisjrez.maintenancetracker",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera reads VINs, odometers and transfer codes. Nothing is recorded or uploaded.",
        "NSLocalNetworkUsageDescription": "Maintenance Tracker connects to its server on your local network.",
        "EXDevMenuShowsAtLaunch": false,
        "EXDevMenuIsOnboardingFinished": true,
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "android": {
      "package": "dev.luisjrez.maintenancetracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "react-native-vision-camera-mlkit",
        {
          "textRecognition": true,
          "textRecognitionChinese": false,
          "textRecognitionDevanagari": false,
          "textRecognitionJapanese": false,
          "textRecognitionKorean": false,
          "barcodeScanning": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
